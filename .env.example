# This aggregate is a reference only. For local development, copy the templates
# in apps/api/.env.example and apps/web/.env.example into their respective apps.

# API (development)
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/mymacademia
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PUBLIC_ORGANIZATION_SLUG=mym-academia

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
TRUST_PROXY_HOPS=0

MONGODB_MAX_POOL_SIZE=5
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_CONNECTING=2
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=M&M Academia

# Web (development only; production uses same-origin /api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
