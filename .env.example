# API
# In production (NODE_ENV=production) APP_ORIGIN, MONGODB_URI and JWT_ACCESS_SECRET
# are REQUIRED and must not be the local development values; see apps/api/.env.example.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/mymacademia
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Gmail / Nodemailer
GMAIL_USER=mymacademiadebaile@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM="M&M Academia <mymacademiadebaile@gmail.com>"

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api
