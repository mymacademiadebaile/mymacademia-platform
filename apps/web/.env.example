# Used only for standalone local development. In Vercel production the browser
# automatically calls the same-origin `/api` path; do not set this variable.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public SEO origin is fixed in apps/web/src/lib/public-site/site.ts.
# Legacy NEXT_PUBLIC_SITE_URL is no longer read; APP_ORIGIN remains independent.

# Public website data: "api" (default, published catalog from the backoffice) or "mock" (fictional content, no backend).
# PUBLIC_DATA_SOURCE=api
