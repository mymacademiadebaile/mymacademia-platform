{
  "name": "@mym/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @mym/shared build && tsx watch src/server.ts",
    "prebuild": "pnpm --filter @mym/shared build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed:admin": "pnpm --filter @mym/shared build && tsx src/scripts/seed-admin.ts",
    "pretypecheck": "pnpm --filter @mym/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prelint": "pnpm --filter @mym/shared build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @mym/shared build",
    "test": "vitest run",
    "seed:initial": "pnpm --filter @mym/shared build && tsx src/scripts/seed-admin.ts",
    "sync:schedule": "tsx src/scripts/sync-mym-schedule.ts",
    "seed:natalia-catalogs": "pnpm --filter @mym/shared build && tsx src/scripts/seed-natalia-catalogs.ts",
    "payments:backfill-charge-keys": "pnpm --filter @mym/shared build && tsx src/scripts/backfill-payment-charge-keys.ts",
    "seed:public-demo": "pnpm --filter @mym/shared build && tsx src/scripts/seed-public-demo.ts",
    "migrate:scheduling-billing": "pnpm --filter @mym/shared build && tsx src/scripts/migrate-scheduling-billing.ts",
    "payments:purge-legacy": "pnpm --filter @mym/shared build && tsx src/scripts/purge-legacy-payments.ts",
    "jobs:daily": "pnpm --filter @mym/shared build && tsx src/scripts/daily-jobs.ts",
    "migrate:identity": "tsx src/scripts/migrate-identity.ts"
  },
  "dependencies": {
    "@mym/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.17.2",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
