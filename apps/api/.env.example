# Local development values. In Vercel, do not configure NODE_ENV or PORT:
# Vercel supplies them. Production requires real APP_ORIGIN, MONGODB_URI and
# JWT_ACCESS_SECRET values in the project Environment Variables.
NODE_ENV=development
PORT=4000
# REQUIRED in production: public origin of this same Vercel deployment.
APP_ORIGIN=http://localhost:3000

# REQUIRED in production.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/mymacademia
# REQUIRED in production: long random secret, at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mymacademiadebaile@gmail.com
SMTP_PASSWORD=
MAIL_FROM_NAME=M&M Academia

# Only required when running the initial seed.
# ADMIN_EMAIL defaults to SMTP_USER.
ADMIN_PASSWORD=

# Organization whose published rhythms, professors and classes the public website shows.
PUBLIC_ORGANIZATION_SLUG=mym-academia

# Secret of the daily job (sessions window + monthly fees). Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>" to GET /api/internal/jobs/daily. Empty disables it.
CRON_SECRET=
