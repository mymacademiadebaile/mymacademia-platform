# When NODE_ENV=production the API refuses to start unless JWT_ACCESS_SECRET,
# MONGODB_URI and APP_ORIGIN are all set to real, non-development values
# (no localhost fallbacks, no placeholder secret, secret of 32+ characters).
# In development they fall back to local defaults when omitted.
NODE_ENV=development
PORT=4000
# REQUIRED in production: public URL of the web app (CORS origin).
APP_ORIGIN=http://localhost:3000

# REQUIRED in production.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/mymacademia
# REQUIRED in production: long random secret, at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mymacademiadebaile@gmail.com
SMTP_PASSWORD=
MAIL_FROM_NAME=M&M Academia

# Only required when running the initial seed.
# ADMIN_EMAIL defaults to SMTP_USER.
ADMIN_PASSWORD=
